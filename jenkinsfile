pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
            }
        }

        stage('Validate HTML') {
            steps {
                echo 'Checking HTML file...'
                bat 'if not exist index.html exit /b 1'
                bat 'findstr /I /C:"<html" index.html'
            }
        }

        stage('Build') {
            steps {
                echo 'Building HTML application...'
                bat 'if not exist index.html exit /b 1'
                echo 'HTML application build completed successfully.'
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging HTML application...'
                archiveArtifacts artifacts: 'index.html', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
        }

        failure {
            echo 'CI Pipeline failed!'
        }
    }
}
